# ==========================================
# Discord Configuration
# ==========================================
DISCORD_TOKEN=your_discord_bot_token_here
OWNER_USER_ID=your_discord_user_id
DISCORD_GUILD_ALLOWLIST=123456789012345678,987654321098765432
DISCORD_USER_ALLOWLIST=123456789012345678
ADMIN_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ==========================================
# Gemini / AI Model Configuration
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
STT_PROVIDER=gemini
STT_MODEL=gemini-3.5-flash-lite
TTS_PROVIDER=edge
TTS_MODEL=id-ID-GadisNeural
TTS_VOICE_ID=id-ID-GadisNeural
TTS_SPEED=1.12
TTS_PITCH=18
LIVE_MODEL=gemini-2.0-flash-exp
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_DEFAULT_SPEAKER=46
VOICEVOX_SPEAKERS=46,14
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=0CzBBZVHSe1kKQOUHVzq
ELEVENLABS_VOICE_ID_2=N9pacNE5zbJ3p2Zw6iuD
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
ELEVENLABS_OUTPUT_FORMAT=pcm_48000

# ==========================================
# Voice & Interaction Configuration
# ==========================================
INTERACTION_MODE=wake
WAKE_WORDS=Lyra,Lira,Airi,Bot,Halo
VAD_HANGOVER_MS=1000
VOICE_MAX_OUTPUT_TOKENS=40
VOICE_MIN_WORDS_THRESHOLD=2
MAX_UTTERANCE_SEC=30
MAX_REPLY_SEC=20
BARGE_IN_THRESHOLD_MS=300

# ==========================================
# Safety, Rate Limiting & Budgets
# ==========================================
RATE_LIMIT_PER_MIN=6
DAILY_REQUEST_BUDGET=1000
DAILY_TOKEN_BUDGET=500000
TIMEOUT_STT_MS=10000
TIMEOUT_LLM_MS=8000
TIMEOUT_TTS_MS=5000
BOT_ENABLED=true

# ==========================================
# Storage & Persona
# ==========================================
MEMORY_DB_URL=file:./data/memory.sqlite
TRANSCRIPT_RETENTION_DAYS=7
PERSONA_DIR=persona/

# ==========================================
# Observability & Operational
# ==========================================
LOG_LEVEL=info
DEBUG_SAVE_AUDIO=false
HEALTH_PORT=8080
NODE_ENV=development
