# ==========================================
# Discord Configuration
# ==========================================
DISCORD_TOKEN=your_discord_bot_token_here
OWNER_USER_ID=your_discord_user_id
DISCORD_GUILD_ALLOWLIST=123456789012345678,987654321098765432
DISCORD_USER_ALLOWLIST=123456789012345678
ADMIN_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ==========================================
# Gemini / AI Model Configuration
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
STT_PROVIDER=gemini
STT_MODEL=gemini-2.5-flash
TTS_PROVIDER=gemini
TTS_MODEL=gemini-2.5-flash
TTS_VOICE_ID=Puck
LIVE_MODEL=gemini-2.0-flash-exp

# ==========================================
# Voice & Interaction Configuration
# ==========================================
INTERACTION_MODE=wake
WAKE_WORDS=Airi,Bot,Halo
VAD_HANGOVER_MS=500
MAX_UTTERANCE_SEC=30
MAX_REPLY_SEC=20
BARGE_IN_THRESHOLD_MS=300

# ==========================================
# Safety, Rate Limiting & Budgets
# ==========================================
RATE_LIMIT_PER_MIN=6
DAILY_REQUEST_BUDGET=1000
DAILY_TOKEN_BUDGET=500000
TIMEOUT_STT_MS=5000
TIMEOUT_LLM_MS=8000
TIMEOUT_TTS_MS=5000
BOT_ENABLED=true

# ==========================================
# Storage & Persona
# ==========================================
MEMORY_DB_URL=file:./data/memory.sqlite
TRANSCRIPT_RETENTION_DAYS=7
PERSONA_DIR=persona/

# ==========================================
# Observability & Operational
# ==========================================
LOG_LEVEL=info
DEBUG_SAVE_AUDIO=false
HEALTH_PORT=8080
NODE_ENV=development
